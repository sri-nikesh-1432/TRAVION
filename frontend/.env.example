# Travion Frontend — copy to .env for local development. Only non-secret,
# browser-safe values live here (anything prefixed VITE_ ships in the bundle).
#
# Local development (Vite dev server):
VITE_API_BASE_URL=http://localhost:8002/api/v1
#
# Production (Netlify): set VITE_API_BASE_URL in the Netlify UI to the Render
# backend, e.g. https://travion-api.onrender.com/api/v1 — then redeploy, since
# Vite embeds the value at build time. If left unset in production, the app
# falls back to same-origin /api/v1 and relies on the Netlify proxy redirect.

# Google Maps (browser key, restricted by HTTP referrer in Google Cloud Console)
VITE_GOOGLE_MAPS_API_KEY=

# Razorpay key ID is a public identifier; the key SECRET must NEVER appear here.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
