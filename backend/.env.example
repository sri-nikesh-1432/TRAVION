# Travion Backend — copy to .env and fill real values. NEVER commit .env.
# Local development defaults to SQLite automatically; on Render set DATABASE_URL
# to your PostgreSQL connection string and everything switches automatically.

# PostgreSQL (production / Render):
# DATABASE_URL=postgresql://user:password@host:5432/travion
# SQLite (local development — default if unset):
# DATABASE_URL=sqlite:///./travion.db

# JWT signing secret — REQUIRED in production (set a long random string on Render)
JWT_SIGNING_SECRET=change-me-to-a-long-random-string

# Authorized Access entry codes — server-side only (SIH-MANAGER / SIH-ADMIN style)
MANAGER_ELEVATION_SECRET=SIH-MANAGER
ADMIN_ELEVATION_SECRET=SIH-ADMIN

# CORS allow-list, comma-separated. Always include the deployed frontend origin.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://travions.netlify.app,https://travion18.netlify.app

# AI Reasoning (Google Gemini API key) — backend-only, never exposed to the frontend
GEMINI_API_KEY=

# Weather triggers (OpenWeatherMap API key) — backend-only
OPENWEATHER_API_KEY=

# Razorpay — use rzp_test_ keys for test mode, rzp_live_ for production
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
